<?xml version="1.0" encoding="utf-8"?>
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/color_light"
        tools:context=".SuperAsignarFecha">

    <ProgressBar
        android:id="@+id/progressBar6"
        style="@android:style/Widget.DeviceDefault.Light.ProgressBar.Large"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true" />

        <RelativeLayout
            android:id="@+id/relbot"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="0dp"
            android:background="@drawable/color_medium">

            <TextView
                android:id="@+id/textView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="5dp"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imageView7"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:onClick="doExit"
                app:srcCompat="@drawable/arr_back" />

            <ImageView
                android:id="@+id/imageView48"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentTop="false"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="0dp"
                android:layout_marginEnd="3dp"
                android:clickable="true"
                android:onClick="doApply"
                android:padding="3dp"
                app:srcCompat="@drawable/btn_saveb" />

        </RelativeLayout>

    <RelativeLayout
        android:id="@+id/reltop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/color_dark"
        android:minHeight="48dp">

        <TextView
            android:id="@+id/textView14"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:gravity="center"
            android:paddingEnd="5dp"
            android:text="Titulo"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recview"
        android:layout_width="match_parent"
        android:layout_height="219dp"
        android:layout_above="@+id/reldata"
        android:layout_below="@+id/reltop"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp" />

    <RelativeLayout
        android:id="@+id/reldata"
        android:layout_width="match_parent"
        android:layout_height="156dp"
        android:layout_above="@+id/relbot"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:layout_marginBottom="2dp"
        android:background="@drawable/frame_btn"
        android:padding="5dp">

        <TextView
            android:id="@+id/textView47"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/textView46"
            android:layout_alignBottom="@+id/textView46"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="0dp"
            android:background="@drawable/spinner_style"
            android:clickable="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:onClick="doDur"
            android:paddingStart="15dp"
            android:paddingTop="8dp"
            android:paddingEnd="30dp"
            android:paddingBottom="8dp"
            android:singleLine="true"
            android:text="12"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textView46"
            android:layout_width="67dp"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/relfilter"
            android:layout_alignEnd="@+id/textView44"
            android:layout_marginStart="85dp"
            android:layout_marginTop="99dp"
            android:layout_marginEnd="0dp"
            android:layout_toEndOf="@+id/imageView46"
            android:background="@drawable/spinner_style"
            android:clickable="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:onClick="doMin"
            android:paddingStart="15dp"
            android:paddingTop="8dp"
            android:paddingEnd="30dp"
            android:paddingBottom="8dp"
            android:singleLine="true"
            android:text="12"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RelativeLayout
            android:id="@+id/relfilter"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_below="@+id/reltop"
            android:layout_marginStart="2dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="2dp">

            <ImageView
                android:id="@+id/imageView45"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:padding="8dp"
                app:srcCompat="@drawable/icon_users" />

            <TextView
                android:id="@+id/textView41"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="3dp"
                android:layout_toEndOf="@+id/imageView45"
                android:background="@drawable/spinner_style"
                android:clickable="true"
                android:ellipsize="end"
                android:maxLines="1"
                android:onClick="doUsers"
                android:paddingStart="15dp"
                android:paddingTop="8dp"
                android:paddingEnd="30dp"
                android:paddingBottom="8dp"
                android:singleLine="true"
                android:text="TextView"
                android:textSize="16sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <ImageView
            android:id="@+id/imageView46"
            android:layout_width="36dp"
            android:layout_height="48dp"
            android:layout_below="@+id/relfilter"
            android:layout_alignStart="@+id/relfilter"
            android:layout_marginStart="0dp"
            android:layout_marginTop="-3dp"
            android:clickable="true"
            android:onClick="doPrev"
            app:srcCompat="@drawable/arrprev" />

        <TextView
            android:id="@+id/textView44"
            android:layout_width="146dp"
            android:layout_height="36dp"
            android:layout_below="@+id/relfilter"
            android:layout_marginStart="5dp"
            android:layout_marginTop="4dp"
            android:layout_toEndOf="@+id/imageView46"
            android:background="@drawable/frame_round"
            android:gravity="center"
            android:text="23/12 Jue"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imageView47"
            android:layout_width="36dp"
            android:layout_height="48dp"
            android:layout_alignTop="@+id/imageView46"
            android:layout_alignBottom="@+id/imageView46"
            android:layout_marginStart="5dp"
            android:layout_toEndOf="@+id/textView44"
            android:clickable="true"
            android:onClick="doNext"
            app:srcCompat="@drawable/arrnext" />

        <TextView
            android:id="@+id/textView45"
            android:layout_width="67dp"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/relfilter"
            android:layout_marginStart="5dp"
            android:layout_marginTop="99dp"
            android:layout_marginEnd="5dp"
            android:layout_toEndOf="@+id/imageView46"
            android:background="@drawable/spinner_style"
            android:clickable="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:onClick="doHour"
            android:paddingStart="15dp"
            android:paddingTop="8dp"
            android:paddingEnd="30dp"
            android:paddingBottom="8dp"
            android:singleLine="true"
            android:text="23"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imageView49"
            android:layout_width="38dp"
            android:layout_height="45dp"
            android:layout_alignStart="@+id/imageView46"
            android:layout_alignTop="@+id/textView45"
            android:layout_alignBottom="@+id/textView45"
            android:padding="7dp"
            app:srcCompat="@drawable/icon_hour" />

        <ImageView
            android:id="@+id/imageView50"
            android:layout_width="36dp"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/textView46"
            android:layout_alignBottom="@+id/textView46"
            android:layout_marginEnd="5dp"
            android:layout_toStartOf="@+id/textView47"
            android:padding="6dp"
            app:srcCompat="@drawable/icon_duration" />

    </RelativeLayout>

</RelativeLayout>