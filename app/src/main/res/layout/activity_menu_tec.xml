<?xml version="1.0" encoding="utf-8"?>
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/color_light"
        tools:context=".MenuTec">

        <RelativeLayout
            android:id="@+id/relcal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_above="@id/relbot"/>

    <RelativeLayout
        android:id="@+id/relbot"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="0dp"
        android:background="@drawable/color_medium">

        <ImageView
            android:id="@+id/imageView13"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:layout_marginStart="1dp"
            android:layout_marginTop="1dp"
            android:layout_marginEnd="1dp"
            android:layout_marginBottom="1dp"
            android:adjustViewBounds="true"
            android:clickable="true"
            android:onClick="doNueva"
            android:padding="2dp"
            app:srcCompat="@drawable/add_circle" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginHorizontal="5dp"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="Nombre"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textView31"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/textView"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="3dp"
            android:text="TextView"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="visible" />

        <ImageView
            android:id="@+id/imageView24"
            android:layout_width="24dp"
            android:layout_height="20dp"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="5dp"
            android:layout_toStartOf="@+id/imageView25"
            android:adjustViewBounds="true"
            android:visibility="invisible"
            app:srcCompat="@drawable/redpoint" />

        <ImageView
            android:id="@+id/imageView25"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="1dp"
            android:layout_marginTop="1dp"
            android:layout_marginEnd="1dp"
            android:layout_marginBottom="1dp"
            android:adjustViewBounds="true"
            android:clickable="true"
            android:onClick="doCom"
            android:padding="8dp"
            app:srcCompat="@drawable/icon_undo" />

    </RelativeLayout>

        <RelativeLayout
            android:id="@+id/reltop"
            android:layout_width="match_parent"
            android:layout_height="48dp">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:adjustViewBounds="true"
                android:contextClickable="false"
                android:cropToPadding="false"
                android:scaleType="fitXY"
                android:src="@drawable/mposgerhead" />

            <TextView
                android:id="@+id/textView15"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="false"
                android:layout_centerInParent="true"
                android:layout_marginStart="5dp"
                android:layout_marginTop="0dp"
                android:layout_marginEnd="0dp"
                android:paddingEnd="15dp"
                android:text="Módulo Tecnico"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

        </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/relfilter"
        android:layout_alignBottom="@+id/relcal"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="5dp" />

    <RelativeLayout
        android:id="@+id/relfilter"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@+id/reltop"
        android:layout_marginTop="2dp"
        android:background="@drawable/frame_btn"
        android:padding="5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textView43"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/frame_key_select"
                android:clickable="true"
                android:gravity="center"
                android:onClick="doPendClick"
                android:text="Pendiente"
                android:textColor="#BA5536"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textView42"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="2dp"
                android:layout_weight="1"
                android:background="@drawable/frame_btn"
                android:clickable="true"
                android:gravity="center"
                android:onClick="doActClick"
                android:text="Activo"
                android:textColor="#BA5536"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textView38"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/frame_btn"
                android:clickable="true"
                android:gravity="center"
                android:onClick="doCompClick"
                android:text="Completo"
                android:textColor="#BA5536"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

</RelativeLayout>